{
  "expo": {
    "name": "ViaAce Xpress",
    "slug": "viaace-xpress",
    "owner": "fizafeez9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./84E5DCE8-6EE3-441A-A5BD-6C50E5CC4692.png",
    "scheme": "viaacexpress",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "my.viaace.xpress"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./84E5DCE8-6EE3-441A-A5BD-6C50E5CC4692.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "my.viaace.xpress"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./84E5DCE8-6EE3-441A-A5BD-6C50E5CC4692.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./84E5DCE8-6EE3-441A-A5BD-6C50E5CC4692.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "bbb1ed02-5bff-4690-95fc-7dfaac95bf6f"
      }
    }
  }
}
